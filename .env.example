# OmnixStorage Docker Compose Environment Variables
# Copy this to .env and customize for your deployment

# Docker Image Tag
OMNIX_TAG=omnixstorage

# Public Domain (used by Traefik for routing in Coolify)
# Set this to your actual domain, e.g., demo.omnixstorage.kegeosapps.com
OMNIX_PUBLIC_DOMAIN=localhost

# Admin Console Credentials
OMNIX_ADMIN_USER=admin
OMNIX_ADMIN_PASSWORD=omnix-console-2026

# S3 API Credentials
OMNIX_S3_ACCESS_KEY=admin
OMNIX_S3_SECRET_KEY=omnix-secret-2026

# Console API URL (used by the web UI to connect to the storage API)
# LOCAL DEVELOPMENT:
#   - http://localhost:9000 (HTTP only, internal communication)
#
# COOLIFY DEPLOYMENT (IMPORTANT):
#   ISSUE: Coolify reverse proxy may only route to one service by default
#   
#   Option A (Recommended):
#   - Expose BOTH ports 3001 (console) and 9000 (API) in Coolify
#   - Use: https://demo.omnixstorage.kegeosapps.com:9000
#   
#   Option B (If only HTTP internally):
#   - Use internal container URL: http://omnix-node1:5000
#   - Browser may block due to CORS/mixed content
#
# COOLIFY SETUP STEPS:
#   1. In Coolify Dashboard > Application > Settings > Ports/Expose
#   2. Add TWO port bindings:
#      - Port 3001 (console/UI)
#      - Port 9000 (API backend)  
#   3. Set this variable to: https://YOUR_DOMAIN:9000
#   4. Redeploy
#
OMNIX_CONSOLE_API_URL=https://demo.omnixstorage.kegeosapps.com:9000
