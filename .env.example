# OmnixStorage Docker Compose Environment Variables
# Copy this to .env and customize for your deployment

# Docker Image Tag
OMNIX_TAG=omnixstorage

# Admin Console Credentials
OMNIX_ADMIN_USER=admin
OMNIX_ADMIN_PASSWORD=omnix-console-2026

# S3 API Credentials
OMNIX_S3_ACCESS_KEY=admin
OMNIX_S3_SECRET_KEY=omnix-secret-2026

# Console API URL (used by the web UI to connect to the storage API)
# LOCAL DEVELOPMENT:
#   - http://localhost:9000 (HTTP only, internal communication)
#
# COOLIFY DEPLOYMENT (recommended):
#   - https://demo.omnixstorage.kegeosapps.com (HTTPS via Coolify reverse proxy)
#   - Coolify automatically routes to omnix-node1:5000 internally
#   - Coolify manages SSL certificate renewal with Let's Encrypt
#   
# HOW COOLIFY SSL WORKS:
#   1. Coolify receives HTTPS requests on port 443 for your domain
#   2. Coolify's reverse proxy (nginx) terminates SSL encryption
#   3. Coolify forwards HTTP requests internally to your containers
#   4. SSL certificate is automatically renewed 30 days before expiration
#   5. Renewals happen without downtime or intervention required
#
# CERTIFICATE RENEWAL DETAILS:
#   - Provider: Let's Encrypt (free)
#   - Auto-renewal: Enabled by default in Coolify
#   - Renewal check: Daily at midnight UTC
#   - Renewal window: Starts 30 days before expiration
#   - Zero-downtime: Renewal happens without stopping services
#
# TO VERIFY CERTIFICATE STATUS IN COOLIFY:
#   1. Dashboard > Application > Settings > SSL
#   2. Check the "Certificate Expiration Date"
#   3. View renewal logs in the application logs
#
# TROUBLESHOOTING SSL RENEWAL FAILURES:
#   - Ensure domain DNS points to your Coolify server
#   - Check Coolify logs: Dashboard > Application > Logs > Deployments
#   - Manual renewal: Dashboard > SSL Section > "Regenerate Certificate"
#   - Contact Coolify support if automatic renewal fails
#
OMNIX_CONSOLE_API_URL=https://demo.omnixstorage.kegeosapps.com
